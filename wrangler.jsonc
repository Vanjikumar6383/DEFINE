/**
 * Cloudflare Wrangler Configuration
 * Project: DEFINE 4.0 / Nimad AI Conversation Copilot
 *
 * Deployment:
 * - Local preview:  npx wrangler dev
 * - Production:     npx wrangler deploy
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "define",
  "main": "./worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Cloudflare Workers Static Assets for serving HTML, CSS, JS, and media
  "assets": {
    "directory": "./pr007-conversation-copilot/frontend",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },

  // Environment variables
  "vars": {
    "ENVIRONMENT": "production",
    // Connected to your active cloudflared tunnel:
    "BACKEND_API_URL": "https://installed-championship-entered-contrary.trycloudflare.com"
  },

  "observability": {
    "enabled": true
  }
}
