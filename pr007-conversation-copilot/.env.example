APP_ENV=development
APP_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Database (default: SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./copilot.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/copilot

# Optional Redis
# REDIS_URL=redis://localhost:6379/0

# AI Provider
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=

# Model selection
AI_MODEL=llama-3.3-70b-versatile

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Session
SESSION_RETENTION_DAYS=30
STORE_RAW_AUDIO=false

# Meeting Platform Integrations (OAuth & Webhooks)
# Leave blank to run in honest manual/extension MVP mode without external API credentials
GOOGLE_CLIENT_ID=your_google_workspace_client_id_here
GOOGLE_CLIENT_SECRET=your_google_workspace_client_secret_here
ZOOM_CLIENT_ID=your_zoom_oauth_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_oauth_client_secret_here
MICROSOFT_CLIENT_ID=your_azure_ad_client_id_here
MICROSOFT_CLIENT_SECRET=your_azure_ad_client_secret_here
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
