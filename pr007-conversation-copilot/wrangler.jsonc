/**
 * Cloudflare Wrangler Configuration
 * Location: pr007-conversation-copilot
 *
 * Deployment:
 * - Local preview:  npx wrangler dev
 * - Production:     npx wrangler deploy
 */
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "define-copilot",
  "main": "./worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Cloudflare Workers Static Assets for frontend
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },

  "vars": {
    "ENVIRONMENT": "production",
    "BACKEND_API_URL": "https://installed-championship-entered-contrary.trycloudflare.com"
  },

  "observability": {
    "enabled": true
  }
}
